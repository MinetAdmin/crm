# Copy to .env.local (Next.js) and .env (Prisma/scripts); never commit either.

# Local Postgres, database "crmdev". See README "Local setup".
DATABASE_URL="postgresql://localhost:5432/crmdev"

# Auth.js secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Entra ID app registration: single tenant, "Assignment required" on (doc 03 §2.1).
# Redirect URI to register: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Pin to the Minet tenant, never /common:
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
