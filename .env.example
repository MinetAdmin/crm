# Copy to .env; never commit it. Next.js and the db scripts both read that file.

# Local Postgres. The username is required: without it Prisma fails with
# "User was denied access on the database". On a Homebrew install it is your
# macOS username. Create the database first with: createdb crmdev
DATABASE_URL="postgresql://USER@localhost:5432/crmdev"

# Auth.js secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Entra ID app registration: single tenant (doc 03 §2.1). No app assignment needed;
# invites are issued in the CRM admin UI.
# Redirect URI to register: http://localhost:3000/api/auth/callback/microsoft-entra-id
# ID is the Application (client) ID, a UUID.
AUTH_MICROSOFT_ENTRA_ID_ID=""
# SECRET is the secret Value from Certificates & secrets, not the Secret ID.
# The Value is shown only once, at creation, and is not a UUID.
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Pin to the Minet tenant, never /common:
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
